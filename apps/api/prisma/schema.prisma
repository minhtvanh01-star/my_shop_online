generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum CouponType {
  percentage
  fixed
}

enum EmailStatus {
  pending
  sent
  failed
  bounced
}

enum InventoryTxType {
  purchase
  sale
  return
  adjustment
  damage
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum PostStatus {
  draft
  published
  archived
}

enum PageStatus {
  draft
  published
  archived
}

// ============================================================
// GROUP 1: USERS & AUTH
// ============================================================

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  passwordHash String?
  fullName     String
  phone        String?
  locale       String    @default("en")
  countryCode  String?
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  // Soft delete
  deletedAt    DateTime?
  deletedBy    String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions             Session[]
  oauthAccounts        OAuthAccount[]
  addresses            UserAddress[]
  wishlists            Wishlist[]
  orders               Order[]
  cartItems            CartItem[]
  userRoles            UserRole[]             @relation("UserHasRole")
  rolesGranted         UserRole[]             @relation("UserGrantedRole")
  adminAccount         AdminAccount?
  auditLogs            AuditLog[]
  activityLogs         UserActivityLog[]
  notifications        Notification[]
  emailLogs            EmailLog[]
  reviews              ProductReview[]
  posts                Post[]
  pages                Page[]
  mediaFiles           MediaFile[]
  systemConfigsUpdated SystemConfig[]
  featureFlagsUpdated  FeatureFlag[]
  inventoryActions     InventoryTransaction[]

  @@index([isActive])
  @@map("users")
}

model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OAuthAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  provider       String
  providerUserId String
  providerData   Json?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model UserAddress {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @db.Uuid
  label         String?
  recipientName String
  phone         String?
  addressLine1  String
  addressLine2  String?
  city          String
  state         String?
  postalCode    String?
  countryCode   String
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

// ============================================================
// GROUP 2: PRODUCTS & CATALOG
// ============================================================

model Category {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId  String?   @db.Uuid
  slug      String    @unique
  name      String
  imageUrl  String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  // Audit
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  // Soft delete
  deletedAt DateTime?
  deletedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  parent   Category?  @relation("CategorySelf", fields: [parentId], references: [id])
  children Category[] @relation("CategorySelf")
  products Product[]

  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String    @db.Uuid
  slug          String    @unique
  sku           String    @unique
  basePrice     Decimal   @db.Decimal(12, 4)
  currency      String    @default("USD")
  stockQuantity Int       @default(0)
  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  attributes    Json?
  // Audit
  createdBy     String?   @db.Uuid
  updatedBy     String?   @db.Uuid
  // Soft delete
  deletedAt     DateTime?
  deletedBy     String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category              Category               @relation(fields: [categoryId], references: [id])
  translations          ProductTranslation[]
  variants              ProductVariant[]
  images                ProductImage[]
  prices                ProductPrice[]
  productTags           ProductTag[]
  wishlists             Wishlist[]
  orderItems            OrderItem[]
  cartItems             CartItem[]
  inventoryTransactions InventoryTransaction[]
  stockAlerts           StockAlert[]
  reviews               ProductReview[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@map("products")
}

model ProductTranslation {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String  @db.Uuid
  locale          String
  name            String
  description     String?
  metaTitle       String?
  metaDescription String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([productId])
  @@map("product_translations")
}

model ProductVariant {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String    @db.Uuid
  sku           String    @unique
  optionName    String
  optionValue   String
  priceModifier Decimal   @default(0) @db.Decimal(12, 4)
  stockQuantity Int       @default(0)
  imageUrl      String?
  isActive      Boolean   @default(true)
  // Audit
  createdBy     String?   @db.Uuid
  updatedBy     String?   @db.Uuid
  // Soft delete
  deletedAt     DateTime?
  deletedBy     String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlists             Wishlist[]
  orderItems            OrderItem[]
  cartItems             CartItem[]
  inventoryTransactions InventoryTransaction[]
  stockAlerts           StockAlert[]

  @@index([productId])
  @@index([isActive])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  // Audit
  createdBy String?  @db.Uuid
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductPrice {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @db.Uuid
  currency    String
  amount      Decimal  @db.Decimal(12, 4)
  compareAt   Decimal? @db.Decimal(12, 4)
  countryCode String?
  // Audit
  updatedBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, currency, countryCode])
  @@index([productId])
  @@map("product_prices")
}

model Tag {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  slug      String    @unique
  color     String?
  isActive  Boolean   @default(true)
  // Audit
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  // Soft delete
  deletedAt DateTime?
  deletedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  productTags ProductTag[]

  @@map("tags")
}

model ProductTag {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @db.Uuid
  tagId     String @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([productId])
  @@index([tagId])
  @@map("product_tags")
}

// ============================================================
// GROUP 3: WISHLIST
// ============================================================

model Wishlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  variantId String?  @db.Uuid
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@index([productId])
  @@map("wishlists")
}

// ============================================================
// GROUP 4: ORDERS & PAYMENTS
// ============================================================

model Order {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber      String      @unique
  userId           String?     @db.Uuid
  status           OrderStatus @default(pending)
  currency         String
  subtotal         Decimal     @db.Decimal(12, 4)
  shippingFee      Decimal     @default(0) @db.Decimal(12, 4)
  discountAmount   Decimal     @default(0) @db.Decimal(12, 4)
  taxAmount        Decimal     @default(0) @db.Decimal(12, 4)
  totalAmount      Decimal     @db.Decimal(12, 4)
  exchangeRate     Decimal     @default(1) @db.Decimal(12, 4)
  shippingAddress  Json
  locale           String      @default("en")
  notes            String?
  shippingMethodId String?     @db.Uuid
  trackingNumber   String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  // Audit — ai xử lý đơn hàng
  processedBy      String?     @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingMethod        ShippingMethod?        @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  orderItems            OrderItem[]
  payments              Payment[]
  orderCoupons          OrderCoupon[]
  inventoryTransactions InventoryTransaction[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String   @db.Uuid
  productId       String   @db.Uuid
  variantId       String?  @db.Uuid
  productName     String
  variantLabel    String?
  sku             String
  quantity        Int
  unitPrice       Decimal  @db.Decimal(12, 4)
  totalPrice      Decimal  @db.Decimal(12, 4)
  currency        String
  productSnapshot Json

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reviews ProductReview[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String        @db.Uuid
  provider         String
  providerTxId     String        @unique
  status           PaymentStatus @default(pending)
  amount           Decimal       @db.Decimal(12, 4)
  currency         String
  providerResponse Json?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Coupon {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String     @unique
  type                CouponType
  value               Decimal    @db.Decimal(12, 4)
  minOrderAmount      Decimal?   @db.Decimal(12, 4)
  maxUses             Int?
  usedCount           Int        @default(0)
  perUserLimit        Int?
  applicableCountries String[]
  startDate           DateTime?
  expiresAt           DateTime?
  isActive            Boolean    @default(true)
  // Audit
  createdBy           String?    @db.Uuid
  updatedBy           String?    @db.Uuid
  // Soft delete
  deletedAt           DateTime?
  deletedBy           String?    @db.Uuid
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  orderCoupons OrderCoupon[]

  @@index([isActive])
  @@map("coupons")
}

model OrderCoupon {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String  @db.Uuid
  couponId        String  @db.Uuid
  discountApplied Decimal @db.Decimal(12, 4)

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coupon Coupon @relation(fields: [couponId], references: [id])

  @@unique([orderId, couponId])
  @@index([orderId])
  @@index([couponId])
  @@map("order_coupons")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  variantId String?  @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@map("cart_items")
}

// ============================================================
// GROUP 5: SHIPPING
// ============================================================

model ShippingMethod {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  provider  String?
  isActive  Boolean   @default(true)
  // Audit
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  // Soft delete
  deletedAt DateTime?
  deletedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders Order[]

  @@map("shipping_methods")
}

// ============================================================
// GROUP 6: ROLES & PERMISSIONS
// ============================================================

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique
  displayName String
  description String?
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  // Audit
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  // Soft delete
  deletedAt   DateTime?
  deletedBy   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource    String
  action      String
  description String?
  isActive    Boolean  @default(true)
  // Audit
  createdBy   String?  @db.Uuid
  updatedBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model UserRole {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  grantedBy String?   @db.Uuid
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  revokedAt DateTime?
  revokedBy String?   @db.Uuid
  createdAt DateTime  @default(now())

  user          User  @relation("UserHasRole", fields: [userId], references: [id], onDelete: Cascade)
  role          Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedByUser User? @relation("UserGrantedRole", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model AdminAccount {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @unique @db.Uuid
  employeeCode String    @unique
  department   String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  // Soft delete
  deletedAt    DateTime?
  deletedBy    String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_accounts")
}

// ============================================================
// GROUP 7: AUDIT & ACTIVITY
// ============================================================

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId      String?  @db.Uuid
  actorType    String
  action       String
  resourceType String
  resourceId   String?
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  userAgent    String?
  requestId    String?
  isSensitive  Boolean  @default(false)
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model LoginAttempt {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier    String
  ipAddress     String
  userAgent     String?
  success       Boolean
  failureReason String?
  countryCode   String?
  createdAt     DateTime @default(now())

  @@index([identifier])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_attempts")
}

model UserActivityLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @db.Uuid
  eventType    String
  pageUrl      String?
  resourceId   String?
  resourceType String?
  metadata     Json?
  ipAddress    String?
  deviceType   String?
  countryCode  String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("user_activity_logs")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  type      String
  channel   String
  title     String
  body      String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model EmailLog {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?     @db.Uuid
  templateId        String?
  toAddress         String
  subject           String
  status            EmailStatus @default(pending)
  providerMessageId String?
  providerResponse  Json?
  retryCount        Int         @default(0)
  sentAt            DateTime?
  createdAt         DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}

// ============================================================
// GROUP 8: INVENTORY & REVIEWS
// ============================================================

model InventoryTransaction {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String          @db.Uuid
  variantId      String?         @db.Uuid
  orderId        String?         @db.Uuid
  actorId        String?         @db.Uuid
  type           InventoryTxType
  quantityChange Int
  quantityBefore Int
  quantityAfter  Int
  note           String?
  createdAt      DateTime        @default(now())

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  order   Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor   User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([orderId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model StockAlert {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String    @db.Uuid
  variantId     String?   @db.Uuid
  threshold     Int
  isActive      Boolean   @default(true)
  lastAlertedAt DateTime?
  // Audit
  createdBy     String?   @db.Uuid
  updatedBy     String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("stock_alerts")
}

model ProductReview {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId          String       @db.Uuid
  userId             String       @db.Uuid
  orderItemId        String?      @db.Uuid
  rating             Int
  title              String?
  body               String?
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(pending)
  helpfulCount       Int          @default(0)
  // Moderation audit
  reviewedBy         String?      @db.Uuid
  reviewedAt         DateTime?
  rejectedReason     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@map("product_reviews")
}

// ============================================================
// GROUP 9: BLOG & CMS
// ============================================================

model PostCategory {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId  String?   @db.Uuid
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  // Audit
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  // Soft delete
  deletedAt DateTime?
  deletedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  parent   PostCategory?  @relation("PostCategorySelf", fields: [parentId], references: [id])
  children PostCategory[] @relation("PostCategorySelf")
  posts    Post[]

  @@index([parentId])
  @@index([isActive])
  @@map("post_categories")
}

model Post {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId         String     @db.Uuid
  categoryId       String     @db.Uuid
  slug             String     @unique
  featuredImageUrl String?
  status           PostStatus @default(draft)
  isFeatured       Boolean    @default(false)
  viewCount        Int        @default(0)
  publishedAt      DateTime?
  // Audit
  updatedBy        String?    @db.Uuid
  // Soft delete
  deletedAt        DateTime?
  deletedBy        String?    @db.Uuid
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  author       User              @relation(fields: [authorId], references: [id])
  category     PostCategory      @relation(fields: [categoryId], references: [id])
  translations PostTranslation[]

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@map("posts")
}

model PostTranslation {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId          String  @db.Uuid
  locale          String
  title           String
  content         String?
  excerpt         String?
  metaTitle       String?
  metaDescription String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@index([postId])
  @@map("post_translations")
}

model Page {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String     @unique
  status    PageStatus @default(draft)
  authorId  String     @db.Uuid
  showInNav Boolean    @default(false)
  sortOrder Int        @default(0)
  // Audit
  updatedBy String?    @db.Uuid
  // Soft delete
  deletedAt DateTime?
  deletedBy String?    @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  author       User              @relation(fields: [authorId], references: [id])
  translations PageTranslation[]

  @@index([authorId])
  @@index([status])
  @@map("pages")
}

model PageTranslation {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId          String  @db.Uuid
  locale          String
  title           String
  content         String?
  metaTitle       String?
  metaDescription String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@index([pageId])
  @@map("page_translations")
}

model MediaFile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadedBy    String?  @db.Uuid
  filename      String
  originalName  String
  mimeType      String
  fileSizeBytes Int
  url           String
  cdnUrl        String?
  altText       String?
  folder        String?
  metadata      Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  uploader User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([uploadedBy])
  @@map("media_files")
}

// ============================================================
// GROUP 10: CONFIG
// ============================================================

model SystemConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  value       String
  dataType    String   @default("string")
  group       String?
  description String?
  isPublic    Boolean  @default(false)
  isEncrypted Boolean  @default(false)
  isActive    Boolean  @default(true)
  updatedBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updater User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([group])
  @@index([isActive])
  @@map("system_configs")
}

model FeatureFlag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  isEnabled   Boolean  @default(false)
  conditions  Json?
  description String?
  updatedBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updater User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("feature_flags")
}
