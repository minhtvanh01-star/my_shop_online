# Copy to apps/web/.env (or .env.local) before `npm run dev`.
# Defaults match package.json: web :3000, API :4000 (not 3030/4040).

# API base including /api/v1 — must match apps/api PORT
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional site URL for metadata (defaults to http://localhost:3000)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe publishable key (pk_test_… / pk_live_…). Leave empty until Stripe checkout is tested.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
